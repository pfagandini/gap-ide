{
  "name": "gap-ide",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c yellow,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "preview": "vite preview",
    "smoke": "node scripts/smoke.mjs",
    "build:electron": "node scripts/build-electron.mjs",
    "app": "npm run build && npm run build:electron && electron .",
    "dist": "npm run build && npm run build:electron && electron-builder"
  },
  "dependencies": {
    "@fastify/static": "^10.1.8",
    "@fastify/websocket": "^11.0.2",
    "fastify": "^5.3.2",
    "pdfkit": "^0.17.1",
    "tsx": "^4.19.3"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/language": "^6.11.0",
    "@codemirror/search": "^6.5.10",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.36.5",
    "@types/node": "^22.15.3",
    "@types/pdfkit": "^0.13.9",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "codemirror": "^6.0.1",
    "concurrently": "^9.1.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.4",
    "ws": "^8.22.0"
  },
  "overrides": {
    "glob": "^14.0.3"
  },
  "license": "MIT",
  "description": "Small IDE for GAP: edit .g files, run cells with inline output, export PDF or LaTeX.",
  "author": {
    "name": "Paulo Fagandini"
  },
  "homepage": "https://github.com/pfagandini/gap-ide",
  "repository": {
    "type": "git",
    "url": "https://github.com/pfagandini/gap-ide.git"
  },
  "main": "dist-electron/main.cjs",
  "build": {
    "appId": "io.github.pfagandini.gapide",
    "productName": "GAP IDE",
    "artifactName": "GAP-IDE-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.education",
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education",
      "syncDesktopName": true
    },
    "publish": {
      "provider": "github",
      "owner": "pfagandini",
      "repo": "gap-ide",
      "releaseType": "draft"
    }
  },
  "desktopName": "gap-ide.desktop"
}
